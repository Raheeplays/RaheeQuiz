{
  "rules": {
    // Global lock for unknowns (non-authenticated)
    ".read": false,
    ".write": false,

    "users": {
      // Allow searching users for login (anonymous auth is session-based)
      ".read": "auth != null",
      
      "$uid": {
        // Validation for creating/updating user records
        // A user can create their record if the key is their auth.uid
        ".write": "auth != null && ( 
          (!data.exists() && $uid == auth.uid) || 
          ($uid == auth.uid && (
            newData.child('status').val() == data.child('status').val() && 
            newData.child('role').val() == data.child('role').val()
          )) || 
          root.child('users').child(auth.uid).child('role').val() == 'admin' 
        )"
      }
    },

    "topics": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    "topicQuizzes": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    "events": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    "history": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'"
    },

    "feedback": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'"
    },

    "leaderboard": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'"
    },

    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    }
  }
}
