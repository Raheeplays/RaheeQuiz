{
  "rules": {
    // Global lock for unknowns
    ".read": false,
    ".write": false,

    "users": {
      // Allow searching users for login
      ".read": "auth != null",
      
      "$username": {
        // Validation for creating/updating user records
        // A user can create their own record if they store their auth.uid in 'firebaseUid'
        // For updates, the stored firebaseUid must match the current auth.uid
        // Status and Role changes are only allowed for admins
        ".write": "auth != null && ( 
          (!data.exists() && newData.child('firebaseUid').val() == auth.uid) || 
          (data.child('firebaseUid').val() == auth.uid && (
            newData.child('status').val() == data.child('status').val() && 
            newData.child('role').val() == data.child('role').val()
          )) || 
          root.child('users').child(auth.uid).child('role').val() == 'admin' 
        )"
      }
    },

    "topics": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    "topicQuizzes": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    "events": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },

    "history": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'"
    },

    "feedback": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'"
    },

    "leaderboard": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('status').val() == 'active'"
    },

    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    }
  }
}
