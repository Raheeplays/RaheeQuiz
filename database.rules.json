{
  "rules": {
    "users": {
        ".indexOn": ["username"],
        "$uid": {
           ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
           ".write": "auth != null && (!data.exists() || $uid == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
           "pendingRequests": {
              "$otherUid": {
                 ".write": "auth != null && (auth.uid == $uid || auth.uid == $otherUid)"
              }
           },
           "friends": {
              "$otherUid": {
                 ".write": "auth != null && (auth.uid == $uid || auth.uid == $otherUid)"
              }
           },
           "challenges": {
              ".write": "auth != null",
              "$challengeId": {
                 ".read": "auth != null && ($uid == auth.uid || data.child('senderId').val() == auth.uid)"
              }
           }
        }
    },
    "public_profiles": {
        ".read": "auth != null",
        ".indexOn": ["username"],
        "$uid": {
            ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
        }
    },
    "history": {
       "$historyId": {
          ".read": "auth != null && (data.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".write": "auth != null && (!data.exists() || data.child('userId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
       }
    },
    "feedback": {
       ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
       "$feedbackId": {
          ".write": "auth != null"
       }
    },
    "topics": {
       ".read": "auth != null",
       ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "quizzes": {
       ".read": "auth != null",
       ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "events": {
       ".read": "auth != null",
       ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "settings": {
       ".read": "auth != null",
       ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "topicQuizzes": {
       ".read": "auth != null",
       ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "matches": {
       "$matchId": {
          ".read": "auth != null && (data.child('participants').hasChild(auth.uid) || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".write": "auth != null && (data.child('participants').hasChild(auth.uid) || !data.exists() || root.child('users').child(auth.uid).child('role').val() == 'admin')"
       }
    },
    "adminConfig": {
       ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
       ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "fcmTokens": {
       ".read": "auth != null",
       "$uid": {
          ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
       }
    }
  }
}
